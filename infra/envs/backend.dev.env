# Django
DJANGO_SETTINGS_MODULE=server.settings.dev
SECRET_KEY=change-me-dev

# Database (matches docker-compose values)
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=applocal
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (dev React on localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Which models to seed & keep active (comma-separated)
SEED_LLM_MODELS=mock:demo

# Global AI (kept for backward-compat; not strictly needed)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=12000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_MS=12000

# Ollama (local or container URL)
# If running Ollama on host (Docker Desktop): http://host.docker.internal:11434
# If running an 'ollama' container: http://ollama:11434
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT_MS=12000
# Optional if you proxy Ollama behind auth
OLLAMA_API_KEY=
